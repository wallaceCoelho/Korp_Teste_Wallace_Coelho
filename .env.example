# =============================================================================
# ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env)
# =============================================================================
# Este arquivo permite que o avaliador ou administrador configure dinamicamente
# as credenciais e provedores dos serviços no Docker Compose.
# =============================================================================

# =============================================================================
# SERVIÇO DE INTELIGÊNCIA ARTIFICIAL (api-ai)
# =============================================================================
# Opções de AI_PROVIDER:
#   - Mock              : Simulação offline local (PADRÃO - não requer chaves nem internet)
#   - OpenAI            : OpenAI oficial (GPT-4o, GPT-4o-mini, etc.)
#   - OpenAICompatible  : Provedores compatíveis com API OpenAI (Groq, DeepSeek, Together, vLLM, LM Studio)
#   - Ollama            : Modelos locais via Ollama (Llama3, Mistral, DeepSeek-R1, Phi3)
#   - AzureOpenAI       : Instâncias corporativas do Azure OpenAI
# =============================================================================

# [PADRÃO RECOMENDADO PARA TESTES LOCAIS / AVALIAÇÃO RÁPIDA]
AI_PROVIDER=Mock
AI_MODEL_ID=mock-ai-v1
AI_API_KEY=
AI_ENDPOINT=
AI_TIMEOUT_SECONDS=30
AI_DEFAULT_TEMPERATURE=0.7

# Cota Diária de Requisições por IP / Usuário
AI_DAILY_LIMIT=15

# -----------------------------------------------------------------------------
# EXEMPLO: Como usar OpenAI Oficial
# -----------------------------------------------------------------------------
# AI_PROVIDER=OpenAI
# AI_MODEL_ID=gpt-4o-mini
# AI_API_KEY=sk-proj-sua-chave-openai-aqui
# AI_ENDPOINT=https://api.openai.com/v1
# AI_TIMEOUT_SECONDS=30
# AI_DEFAULT_TEMPERATURE=0.5

# -----------------------------------------------------------------------------
# EXEMPLO: Como usar Groq (Ultra Rápido)
# -----------------------------------------------------------------------------
# AI_PROVIDER=OpenAICompatible
# AI_MODEL_ID=llama-3.3-70b-versatile
# AI_API_KEY=gsk_sua_chave_groq_aqui
# AI_ENDPOINT=https://api.groq.com/openai/v1
# AI_TIMEOUT_SECONDS=30
# AI_DEFAULT_TEMPERATURE=0.5

# -----------------------------------------------------------------------------
# EXEMPLO: Como usar DeepSeek API
# -----------------------------------------------------------------------------
# AI_PROVIDER=OpenAICompatible
# AI_MODEL_ID=deepseek-chat
# AI_API_KEY=sk-sua-chave-deepseek-aqui
# AI_ENDPOINT=https://api.deepseek.com/v1
# AI_TIMEOUT_SECONDS=45
# AI_DEFAULT_TEMPERATURE=0.5

# -----------------------------------------------------------------------------
# EXEMPLO: Como usar Ollama Local (Offline no seu PC)
# -----------------------------------------------------------------------------
# AI_PROVIDER=Ollama
# AI_MODEL_ID=llama3:8b
# AI_API_KEY=
# AI_ENDPOINT=http://host.docker.internal:11434/v1
# AI_TIMEOUT_SECONDS=60
# AI_DEFAULT_TEMPERATURE=0.7

# =============================================================================
# OBSERVABILIDADE & MONITORAMENTO (Aspire Dashboard)
# =============================================================================
MONITOR_URL=http://localhost:18888
