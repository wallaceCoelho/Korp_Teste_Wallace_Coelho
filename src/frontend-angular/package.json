{
  "name": "frontend-angular",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "set-env": "node scripts/set-env.js",
    "start": "node scripts/set-env.js --env=development && ng serve --configuration development",
    "start:dev": "node scripts/set-env.js --env=development && ng serve --configuration development",
    "start:prod": "node scripts/set-env.js --env=production && ng serve --configuration production",
    "build": "node scripts/set-env.js --env=production && ng build --configuration production",
    "build:dev": "node scripts/set-env.js --env=development && ng build --configuration development",
    "build:prod": "node scripts/set-env.js --env=production && ng build --configuration production",
    "watch": "node scripts/set-env.js --env=development && ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "clsx": "^2.1.1",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "~5.6.2"
  }
}
