{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TesteMicroservicos.AuthServer",
    "Audience": "TesteMicroservicos.Clients",
    "SecretKey": "SuperSecretKeyForJwtAuthenticationInApiGatewaySystem2026!"
  },
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "RateLimiterPolicy": "FixedWindowPolicy",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "categories-route": {
        "ClusterId": "products-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "RateLimiterPolicy": "FixedWindowPolicy",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "invoices-route": {
        "ClusterId": "invoices-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "RateLimiterPolicy": "FixedWindowPolicy",
        "Match": {
          "Path": "/api/invoices/{**catch-all}"
        }
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "RateLimiterPolicy": "FixedWindowPolicy",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "products-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://api-inventory:8080"
          }
        }
      },
      "invoices-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://api-invoicing:8080"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://api-ai:8080"
          }
        }
      }
    }
  }
}
